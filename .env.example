# Copy to .env and fill in. Never commit .env.
# Load it in the shell with:  set -a; source .env; set +a

# Stage C: OpenAI-compatible chat-completions endpoint
#   self-hosted vLLM:  http://localhost:8000/v1/chat/completions
#   GWDG AcademicCloud: https://chat-ai.academiccloud.de/v1/chat/completions
EXTRACTION_ENDPOINT=http://localhost:8000/v1/chat/completions
GWDG_API_KEY=            # only needed for the GWDG API
EXTRACTION_WORKERS=20    # concurrent requests (3 for the GWDG API)

# Stage B: AWS (Athena index lookup + S3 byte-range reads from s3://commoncrawl)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
ATHENA_BUCKET=           # your own S3 bucket for Athena input and query results
